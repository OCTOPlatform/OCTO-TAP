                  "    pm.environment.set('card_id', jsonData.data.cards[0].id);",
                  "    pm.environment.set('card_token', jsonData.data.cards[0].token);",
                  "    console.log('Saved Model B stock card_id:', jsonData.data.cards[0].id);",
                  "}",
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"

{
  "info": {
    "_postman_id": "octo-tap-collection-v1",
    "name": "OCTO Tap — Google Review NFC & QR API",
    "description": "Comprehensive API collection for OCTO Tap (Google Review NFC + QR registration, issuance, QC, lifecycle management, and public redirect).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{admin_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01. Auth",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set('admin_token', jsonData.data.token);",
                  "    console.log('Saved admin_token to environment');",
                  "}",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "auth", "login"]
            }
          }
        },
        {
          "name": "Admin Profile (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Businesses",
      "item": [
        {
          "name": "Create Business",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.id) {",
                  "    pm.environment.set('business_id', jsonData.data.id);",
                  "    console.log('Saved new business_id:', jsonData.data.id);",
                  "}",
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Restoran Sederhana Sudirman\",\n  \"google_review_url\": \"https://g.page/r/CSederhanaReviewDemo/review\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/businesses",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "businesses"]
            }
          }
        },
        {
          "name": "List Businesses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/businesses?search=&status=&limit=20&offset=0",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "businesses"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "status", "value": "" },
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Get Business Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/businesses/{{business_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "businesses", "{{business_id}}"]
            }
          }
        },
        {
          "name": "Update Business",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Restoran Sederhana Sudirman (Updated)\",\n  \"google_review_url\": \"https://maps.app.goo.gl/k98274jkhsd89\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/businesses/{{business_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "businesses", "{{business_id}}"]
            }
          }
        },
        {
          "name": "Verify Business URL",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/businesses/{{business_id}}/verify-url",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "businesses", "{{business_id}}", "verify-url"]
            }
          }
        },
        {
          "name": "Batch Issue Cards for Business",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.cards && jsonData.data.cards.length > 0) {",
                  "    pm.environment.set('card_id', jsonData.data.cards[0].id);",
                  "    pm.environment.set('card_token', jsonData.data.cards[0].token);",
                  "    console.log('Saved card_id:', jsonData.data.cards[0].id);",
                  "    console.log('Saved card_token:', jsonData.data.cards[0].token);",
                  "}",
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "batch-req-{{$timestamp}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 5\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/businesses/{{business_id}}/cards",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "businesses", "{{business_id}}", "cards"]
            }
          }
        },
        {
          "name": "Get Business Production Manifest",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/businesses/{{business_id}}/manifest",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "businesses", "{{business_id}}", "manifest"]
            }
          }
        }
      ]
    },
    {

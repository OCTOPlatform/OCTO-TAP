          "name": "Record Production Event (NFC Verified)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"NFC_VERIFIED\",\n  \"payload\": {\n    \"read_url\": \"{{base_url}}/r/{{card_token}}\"\n  },\n  \"notes\": \"NFC read matches exact redirect URL\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/cards/{{card_id}}/production-events",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "cards", "{{card_id}}", "production-events"]
            }
          }
        },

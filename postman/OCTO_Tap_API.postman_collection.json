        },
        {
          "name": "Record Production Event (NFC Written)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"NFC_WRITTEN\",\n  \"payload\": {\n    \"device\": \"ACR122U NFC Writer\",\n    \"written_url\": \"{{base_url}}/r/{{card_token}}\"\n  },\n  \"notes\": \"NDEF URI tag successfully programmed\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/cards/{{card_id}}/production-events",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "cards", "{{card_id}}", "production-events"]
            }
          }
        },

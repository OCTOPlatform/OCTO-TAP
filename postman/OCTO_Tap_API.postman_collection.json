            "body": {
              "mode": "raw",
              "raw": "{\n  \"business_name\": \"Kopi Kenangan Senopati\",\n  \"google_review_url\": \"https://maps.app.goo.gl/octoDemo123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/cards/{{card_id}}/assign-activate",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "cards", "{{card_id}}", "assign-activate"]
            }
